{
    "name": "@jintianxiayu/logger",
    "version": "0.2.0",
    "description": "A Winston-based named logger factory with YAML configuration, masking and async trace context.",
    "license": "MIT",
    "type": "commonjs",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
    },
    "scripts": {
        "build": "rimraf dist && tsc",
        "test": "jest",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src test --ext .ts",
        "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
        "clean": "rimraf dist"
    },
    "files": [
        "dist",
        "README.md",
        "DESIGN.md"
    ],
    "dependencies": {
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0",
        "yaml": "^2.9.0"
    },
    "devDependencies": {
        "@jest/globals": "^29.7.0",
        "ts-node": "^10.9.2"
    },
    "publishConfig": {
        "access": "public"
    }
}
