{
  "compilerOptions": {
    // ----- 基础环境  -----
    "target": "ES2021",
    "lib": [
      "ES2021"
    ],
    "types": ["node"],
    // ----- 严格类型检查  -----
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true, // 建议开启
    "noUnusedParameters": true, // 建议开启
    "noFallthroughCasesInSwitch": true, // 必须开启
    "noUncheckedIndexedAccess": true, // 强烈推荐
    // ----- 模块系统  -----
    "module": "NodeNext", // 推荐，自动根据 package.json 的 type 字段决定模块格式
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // ----- 输出与源码映射 (推荐分离) -----
    "declaration": true,
    "declarationMap": true, // 对应 declaration 的映射文件
    "sourceMap": true, // 替代 inlineSourceMap
    "outDir": "dist",
    // ----- TypeScript 特有功能 (按需开启) -----
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true // 如使用依赖注入等场景
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}