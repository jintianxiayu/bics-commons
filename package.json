{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "lerna run build",
    "test": "lerna run test",
    "clean": "lerna run clean && rm -rf node_modules",
    "dev": "echo \"Use lerna run dev to run dev in all packages\"",
    "format": "prettier --write \"packages/**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,js,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "lerna": "^9.0.7",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  }
}
