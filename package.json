{
    "name": "root",
    "private": true,
    "packageManager": "pnpm@11.22.0",
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
    },
    "scripts": {
        "prebuild": "pnpm -r run clean",
        "build": "pnpm -r run build",
        "test": "pnpm -r run test",
        "clean": "pnpm -r --reverse run clean",
        "format": "prettier --write \"packages/**/*.{ts,js,json,md}\"",
        "format:check": "prettier --check \"packages/**/*.{ts,js,json,md}\"",
        "lint": "eslint packages --ext .ts",
        "release:status": "pnpm change status",
        "release:version:dry-run": "pnpm version -r --dry-run",
        "release:version": "pnpm version -r && pnpm install --lockfile-only",
        "release:publish:dry-run": "pnpm run build && pnpm test && pnpm -r publish --dry-run",
        "release:publish": "pnpm run build && pnpm test && pnpm -r publish",
        "release:tag": "node scripts/create-release-tags.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.0.0",
        "eslint": "^10.0.1",
        "jest": "^29.7.0",
        "prettier": "^3.8.3",
        "rimraf": "^6.1.3",
        "ts-jest": "^29.4.11",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.4",
        "globals": "^17.12.0"
    }
}
